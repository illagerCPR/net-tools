---
import Layout from "../layouts/Layout.astro";
---

<Layout title="页面不存在" description="没有找到这个页面。">
  <section class="page-head">
    <span class="eyebrow">404</span>
    <h1>没有这个页面</h1>
    <p class="lede">链接可能已经失效，或者工具还没做出来。</p>
  </section>

  <div class="row" style="margin-top: 8px">
    <a class="btn" href="/">回到概览</a>
    <a class="btn btn--ghost" href="/ip/">查询我的 IP</a>
    <a class="btn btn--ghost" href="/dns/">查询 DNS</a>
  </div>
</Layout>
