---
import Layout from "../layouts/Layout.astro";
import { DNS_TYPES } from "../../shared/dns";
import { DEFAULT_RESOLVER_IDS, MAX_CUSTOM_RESOLVERS, RESOLVERS } from "../../shared/resolvers";

const examples = [
  { name: "example.com", type: "A" },
  { name: "github.com", type: "MX" },
  { name: "cloudflare.com", type: "NS" },
  { name: "_dmarc.google.com", type: "TXT" },
  { name: "example.com", type: "CAA" },
];
---

<Layout title="DNS 查询" description="查询 A / AAAA / MX / TXT / CAA 等记录，并对比多个公共解析器与自定义 DoH 端点的结果。">
  <section class="page-head">
    <h1>DNS 记录查询</h1>
    <p class="lede">
      同时向多个解析器发起 DoH 查询并对比结果，也可以临时加上自己的 DoH 端点。查询经本站的边缘节点转发，因此不受本地网络对公共 DNS 的限制。
    </p>
  </section>

  <form class="card stack" id="dns-form" style="gap: 16px">
    <div class="row" style="align-items: flex-end">
      <div class="field" style="flex: 1; min-width: 240px">
        <label for="dns-name">域名</label>
        <input
          class="input mono"
          id="dns-name"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="example.com"
        />
      </div>
      <div class="field" style="width: 150px">
        <label for="dns-type">记录类型</label>
        <select class="select mono" id="dns-type">
          {DNS_TYPES.map((type) => <option value={type}>{type}</option>)}
        </select>
      </div>
      <button class="btn" type="submit">查询</button>
    </div>

    <div class="field">
      <span class="field-label">解析器</span>
      <div class="row" id="dns-resolvers">
        {
          RESOLVERS.map((resolver) => (
            <label class="check" title={resolver.note}>
              <input type="checkbox" name="resolver" value={resolver.id} checked={(DEFAULT_RESOLVER_IDS as readonly string[]).includes(resolver.id)} />
              {resolver.label}
            </label>
          ))
        }
      </div>

      <div class="custom-doh">
        <div class="row" style="gap: 8px; align-items: center">
          <input
            class="input mono"
            id="doh-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            aria-label="自定义 DoH 地址"
            placeholder="https://dns.example.com/dns-query"
            style="flex: 1; min-width: 220px"
          />
          <button class="btn btn--sm btn--ghost" type="button" id="doh-add">添加自定义 DoH</button>
        </div>
        <div class="row" id="doh-list" style="gap: 8px"></div>
        <p class="small muted" style="margin: 0">
          只支持返回 JSON 的 DoH 端点（<span class="mono">application/dns-json</span>），最多 {MAX_CUSTOM_RESOLVERS} 个，
          地址只记在本机浏览器里。查询由本站边缘节点发起，因此局域网 DNS 与 IP:53 都查不到。
        </p>
      </div>
    </div>

    <div class="row small muted" style="gap: 8px">
      <span>示例：</span>
      {
        examples.map((example) => (
          <button class="btn btn--sm btn--ghost" type="button" data-example={`${example.name}|${example.type}`}>
            {example.name} · {example.type}
          </button>
        ))
      }
    </div>
  </form>

  <p class="status-line" id="dns-status" style="margin-top: 12px">输入域名开始查询。</p>
  <div class="stack" id="dns-results" style="margin-top: 6px"></div>

  <p class="note" style="margin-top: 20px">
    结果来自各解析器的 DoH JSON 接口，可能因缓存 TTL 不同而存在短暂差异。DNSSEC 验证状态以「AD」标记表示；自定义端点不做边缘缓存。
  </p>
</Layout>

<script>
  import type { DnsResponse } from "../../shared/api-types";
  import { dnsTypeName } from "../../shared/dns";
  import { MAX_CUSTOM_RESOLVERS, parseCustomDohUrl } from "../../shared/resolvers";
  import { esc, fmtMs, getJson, must, toast } from "../scripts/lib";

  const DOH_STORAGE_KEY = "net-tools.doh";

  const form = must<HTMLFormElement>("#dns-form");
  const nameInput = must<HTMLInputElement>("#dns-name");
  const typeSelect = must<HTMLSelectElement>("#dns-type");
  const dohInput = must<HTMLInputElement>("#doh-input");
  const dohAdd = must<HTMLButtonElement>("#doh-add");
  const dohList = must<HTMLDivElement>("#doh-list");
  const statusLine = must("#dns-status");
  const results = must("#dns-results");

  let savedDoh = readSavedDoh();

  function setStatus(html: string): void {
    statusLine.innerHTML = html;
  }

  function readSavedDoh(): string[] {
    try {
      const raw = localStorage.getItem(DOH_STORAGE_KEY);
      if (!raw) return [];
      const parsed: unknown = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((item): item is string => typeof item === "string").slice(0, MAX_CUSTOM_RESOLVERS);
    } catch {
      return [];
    }
  }

  function persistDoh(): void {
    try {
      localStorage.setItem(DOH_STORAGE_KEY, JSON.stringify(savedDoh));
    } catch {
      // 隐私模式或配额满：只影响是否记住地址，不影响本次查询
    }
  }

  function hostOf(endpoint: string): string {
    try {
      return new URL(endpoint).hostname;
    } catch {
      return endpoint;
    }
  }

  function renderDoh(): void {
    dohList.replaceChildren(
      ...savedDoh.map((endpoint) => {
        const chip = document.createElement("div");
        chip.className = "check check--custom";

        const label = document.createElement("label");
        label.className = "check-label";
        label.title = endpoint;

        const box = document.createElement("input");
        box.type = "checkbox";
        box.name = "doh";
        box.value = endpoint;
        box.checked = true;

        const text = document.createElement("span");
        text.className = "mono";
        text.textContent = hostOf(endpoint);

        label.append(box, text);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "chip-x";
        remove.dataset.remove = endpoint;
        remove.title = "移除";
        remove.setAttribute("aria-label", `移除 ${hostOf(endpoint)}`);
        remove.textContent = "×";

        chip.append(label, remove);
        return chip;
      }),
    );
  }

  function addDoh(raw: string): boolean {
    const value = raw.trim();
    if (!value) {
      toast("请输入 DoH 地址");
      return false;
    }
    const parsed = parseCustomDohUrl(value);
    if (!parsed.ok) {
      toast(parsed.error);
      return false;
    }
    if (savedDoh.includes(parsed.endpoint)) {
      toast("这个地址已经加过了");
      return false;
    }
    if (savedDoh.length >= MAX_CUSTOM_RESOLVERS) {
      toast(`最多 ${MAX_CUSTOM_RESOLVERS} 个自定义 DoH`);
      return false;
    }
    savedDoh = [...savedDoh, parsed.endpoint];
    persistDoh();
    renderDoh();
    toast(`已添加 ${parsed.host}`);
    return true;
  }

  function recordTable(records: Array<{ name: string; ttl: number; typeName: string; data: string }>): string {
    if (records.length === 0) return '<div class="empty">没有记录</div>';
    return `
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th style="width:70px">TTL</th><th style="width:80px">类型</th><th>数据</th></tr></thead>
          <tbody>
            ${records
              .map(
                (record) =>
                  `<tr><td class="mono">${record.ttl}</td><td class="mono">${esc(record.typeName)}</td><td class="mono">${esc(record.data)}</td></tr>`,
              )
              .join("")}
          </tbody>
        </table>
      </div>
    `;
  }

  function renderCard(resolver: DnsResponse["resolvers"][number]): string {
    const state = resolver.ok ? "ok" : "bad";
    const raw = resolver.ok ? (resolver.rcodeName ?? "NOERROR") : (resolver.error ?? "失败");
    const rcode = raw.length > 34 ? `${raw.slice(0, 34)}…` : raw;
    const customBadge = resolver.custom ? '<span class="badge">自定义</span>' : "";
    const adBadge = resolver.ad ? '<span class="badge badge--ok">DNSSEC · AD</span>' : "";
    const authority = resolver.authority.length
      ? `<details style="margin-top: 12px"><summary class="small muted">权威段（${resolver.authority.length} 条）</summary>${recordTable(
          resolver.authority,
        )}</details>`
      : "";

    return `
      <section class="card">
        <div class="card-title">
          <h3>${esc(resolver.label)}</h3>
          <span class="row small muted" style="gap: 8px">
            ${customBadge}
            ${adBadge}
            <span class="badge badge--${state}">${esc(rcode)}</span>
            <span class="mono">${fmtMs(resolver.elapsedMs)}</span>
          </span>
        </div>
        ${recordTable(resolver.answers)}
        ${authority}
      </section>
    `;
  }

  function consensus(resolvers: DnsResponse["resolvers"]): string {
    const successful = resolvers.filter((resolver) => resolver.ok);
    if (successful.length < 2) return "";
    const fingerprints = new Set(
      successful.map((resolver) =>
        resolver.answers
          .map((record) => `${record.typeName}:${record.data}`)
          .sort()
          .join("|"),
      ),
    );
    return fingerprints.size === 1
      ? '<span class="badge badge--ok">各解析器结果一致</span>'
      : '<span class="badge badge--warn">解析器结果不一致</span>';
  }

  async function run(): Promise<void> {
    const name = nameInput.value.trim();
    const type = typeSelect.value;
    const ids = [...document.querySelectorAll<HTMLInputElement>('input[name="resolver"]:checked')].map(
      (element) => element.value,
    );
    const doh = [...document.querySelectorAll<HTMLInputElement>('input[name="doh"]:checked')].map(
      (element) => element.value,
    );

    if (!name) {
      toast("请输入域名");
      return;
    }
    if (ids.length === 0 && doh.length === 0) {
      toast("至少选择一个解析器，或添加自定义 DoH");
      return;
    }

    history.replaceState(null, "", `/dns/?name=${encodeURIComponent(name)}&type=${type}`);
    setStatus(`<span class="spinner" aria-hidden="true"></span>正在查询 <span class="mono">${esc(name)} ${esc(type)}</span>…`);
    results.innerHTML = "";

    const params = new URLSearchParams({ name, type, resolvers: ids.join(",") });
    for (const endpoint of doh.slice(0, MAX_CUSTOM_RESOLVERS)) params.append("doh", endpoint);

    try {
      const data = await getJson<DnsResponse>(`/api/dns?${params.toString()}`, { timeoutMs: 15000 });
      if (!data.ok) throw new Error(data.error ?? "查询失败");

      const via =
        data.via === "edge"
          ? '<span class="badge">经边缘节点</span>'
          : "";
      setStatus(
        `${via} <span class="mono">${esc(data.name)}</span> · ${esc(data.type)} · ${fmtMs(data.elapsedMs)} ${consensus(
          data.resolvers,
        )}`,
      );
      results.innerHTML = data.resolvers.map(renderCard).join("");
      results.classList.add("fade-in");
    } catch (error) {
      const message = error instanceof Error ? error.message : "查询失败";
      // Static deploy fallback: hit AliDNS DoH directly (it allows CORS).
      try {
        const response = await fetch(
          `https://dns.alidns.com/resolve?name=${encodeURIComponent(name)}&type=${encodeURIComponent(type)}`,
          { headers: { accept: "application/dns-json" }, signal: AbortSignal.timeout(8000) },
        );
        const body = (await response.json()) as {
          Status?: number;
          AD?: boolean;
          Answer?: Array<{ TTL?: number; type?: number; data?: string }>;
        };
        const rcodeName = body.Status === 0 ? "NOERROR" : body.Status === 3 ? "NXDOMAIN" : `RCODE${body.Status}`;
        const answers = (body.Answer ?? []).map((record) => ({
          name,
          ttl: record.TTL ?? 0,
          type: Number(record.type ?? 0),
          typeName: dnsTypeName(Number(record.type ?? 0)),
          data: record.data ?? "",
        }));
        setStatus(
          doh.length
            ? '<span class="badge badge--warn">边缘接口不可用，自定义 DoH 无法直连（跨域限制），已退回阿里 DoH</span>'
            : '<span class="badge badge--warn">边缘接口不可用，已直连阿里 DoH</span>',
        );
        results.innerHTML = renderCard({
          id: "ali",
          label: "阿里 AliDNS（直连）",
          ok: body.Status === 0,
          rcodeName,
          ad: body.AD === true,
          truncated: false,
          answers,
          authority: [],
          elapsedMs: 0,
        });
      } catch {
        setStatus(`查询失败：${esc(message)}`);
      }
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    void run();
  });

  dohAdd.addEventListener("click", () => {
    if (addDoh(dohInput.value)) dohInput.value = "";
  });

  dohInput.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    event.preventDefault();
    if (addDoh(dohInput.value)) dohInput.value = "";
  });

  dohList.addEventListener("click", (event) => {
    const trigger = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>("[data-remove]");
    const endpoint = trigger?.dataset.remove;
    if (!endpoint) return;
    savedDoh = savedDoh.filter((item) => item !== endpoint);
    persistDoh();
    renderDoh();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-example]").forEach((button) => {
    button.addEventListener("click", () => {
      const [name, type] = (button.dataset.example ?? "").split("|");
      nameInput.value = name ?? "";
      typeSelect.value = type ?? "A";
      void run();
    });
  });

  renderDoh();

  const params = new URL(location.href).searchParams;
  const initialName = params.get("name");
  const initialType = params.get("type");
  if (initialName) nameInput.value = initialName;
  if (initialType) typeSelect.value = initialType.toUpperCase();
  if (initialName) {
    void run();
  }
</script>
